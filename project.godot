; Engine configuration file.
; Minimal by intent: renderer and main scene only. Anything else added here is
; a decision someone should have to argue for in review.

config_version=5

[application]

config/name="magisteria_interface"
config/description="Godot client for the magisteria basin simulation. Consumes the schema artefact, the terrain export and the fixture; nothing else."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
