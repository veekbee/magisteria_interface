; Engine configuration file.
; Minimal by intent: renderer and main scene only. Anything else added here is
; a decision someone should have to argue for in review.
;
; THE ENGINE REWRITES THIS FILE AND DELETES EVERY COMMENT WHEN IT DOES -- which
; it did once already, on the first run of the app, taking the rule above and
; the note below with it. tests/run_headless.gd asserts both are still here, so
; the next rewrite fails the gate instead of quietly removing the reasons.

config_version=5

[application]

config/name="magisteria_interface"
config/description="Godot client for the magisteria basin simulation. Consumes the schema artefact, the terrain export and the fixture; nothing else."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[filesystem]

; Godot imports .blend natively by shelling out to Blender. tools/blender/
; holds the M5 form-archetype SOURCES, which the project never loads -- and
; headless, with no Blender path configured, that import fails with "Blender
; path is invalid or not set" and turns the gate red over files nothing reads.
;
; Off here rather than behind a .gdignore in that directory: this says what is
; true of the PROJECT, it covers a .blend committed anywhere rather than one
; directory, and it does not hide a directory from the engine along the way.
import/blender/enabled=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
