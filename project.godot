; Engine configuration file.
; Minimal by intent: renderer and main scene only. Anything else added here is
; a decision someone should have to argue for in review. That rule is restated
; in CONTRIBUTING.md, because the engine rewrites this file and deletes every
; comment in it whenever it does -- so nothing here can be relied on to survive.

config_version=5

[application]

config/name="magisteria_interface"
config/description="Godot client for the magisteria basin simulation. Consumes the schema artefact, the terrain export and the fixture; nothing else."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[filesystem]

; Off because Godot imports .blend natively by shelling out to Blender, which
; fails headlessly. The durable copy of this reason is tools/blender/README.md;
; a comment here does not survive the next time the engine writes the file.
import/blender/enabled=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
